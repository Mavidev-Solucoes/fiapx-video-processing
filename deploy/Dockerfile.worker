FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
# Instrumented images are built only for coverage CI, never for production.
ARG FIAPX_COVERAGE=0
RUN if [ "$FIAPX_COVERAGE" = "1" ]; then \
      CGO_ENABLED=0 GOOS=linux go build -cover -covermode=atomic -coverpkg=./... -o /out/worker ./cmd/worker; \
    else \
      CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker; \
    fi

FROM alpine:3.21
RUN apk add --no-cache ffmpeg && addgroup -S fiapx && adduser -S -G fiapx fiapx
COPY --from=build /out/worker /usr/local/bin/worker
USER fiapx
ENTRYPOINT ["/usr/local/bin/worker"]
